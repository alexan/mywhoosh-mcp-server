// Template for your deployment config. Copy it to wrangler.local.jsonc (git-ignored) and fill in
// your own values there, so account-specific ids never end up in the repo:
//   cp wrangler.local.example.jsonc wrangler.local.jsonc
// `npm run deploy` deploys with wrangler.local.jsonc; wrangler.jsonc stays the generic config for
// `npm run dev` and `npm run typecheck`. Keep the rest in sync with wrangler.jsonc.
{
  "name": "mywhoosh-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  // global_fetch_strictly_public: required for OAuth Client ID Metadata Documents
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "MyWhooshMCP" }],
  },
  // new_sqlite_classes = free-tier compatible Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MyWhooshMCP"] }],
  // your namespace id from: npx wrangler kv namespace create mywhoosh-mcp-oauth
  // use a namespace of its own; sharing one with another OAuth worker mixes their grants
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }],
  // OWNER_WHOOSH_IDS is a secret, not a var:
  //   npx wrangler secret put OWNER_WHOOSH_IDS -c wrangler.local.jsonc   (your WhooshId)
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true },
  },
}
